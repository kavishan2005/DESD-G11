from django.shortcuts import render, redirect, get_object_or_404
from django.contrib.auth.decorators import login_required
from django.contrib import messages
from django.db.models import Sum, Count
from .models import Product, Recipe, FarmStory
from orders.models import SubOrder
from payments.models import Payment
from .forms import ProductForm, RecipeForm, FarmStoryForm

@login_required
def producer_dashboard(request):
    if request.user.user_type != 'producer':
        messages.error(request, 'Access denied.')
        return redirect('core:home')
    
    producer = request.user.producer
    products = Product.objects.filter(producer=producer)
    low_stock = products.filter(stock_quantity__lte=models.F('low_stock_threshold'))
    orders = SubOrder.objects.filter(producer=producer, status='pending').count()
    total_revenue = SubOrder.objects.filter(
        producer=producer,
        order__payment_status='succeeded'
    ).aggregate(Sum('producer_payment'))['producer_payment__sum'] or 0
    
    context = {
        'producer': producer,
        'product_count': products.count(),
        'low_stock_count': low_stock.count(),
        'pending_orders': orders,
        'total_revenue': total_revenue,
        'recent_orders': SubOrder.objects.filter(producer=producer).order_by('-created_at')[:5],
        'low_stock_products': low_stock[:5]
    }
    return render(request, 'products/producer_dashboard.html', context)

@login_required
def manage_products(request):
    if request.user.user_type != 'producer':
        return redirect('core:home')
    
    products = Product.objects.filter(producer=request.user.producer)
    
    if request.method == 'POST':
        form = ProductForm(request.POST, request.FILES)
        if form.is_valid():
            product = form.save(commit=False)
            product.producer = request.user.producer
            product.save()
            messages.success(request, 'Product added successfully!')
            return redirect('products:manage_products')
    else:
        form = ProductForm()
    
    context = {
        'products': products,
        'form': form
    }
    return render(request, 'products/manage_products.html', context)

@login_required
def edit_product(request, product_id):
    product = get_object_or_404(Product, id=product_id, producer=request.user.producer)
    
    if request.method == 'POST':
        form = ProductForm(request.POST, request.FILES, instance=product)
        if form.is_valid():
            form.save()
            messages.success(request, 'Product updated successfully!')
            return redirect('products:manage_products')
    else:
        form = ProductForm(instance=product)
    
    context = {
        'form': form,
        'product': product
    }
    return render(request, 'products/edit_product.html', context)

@login_required
def set_surplus(request, product_id):
    product = get_object_or_404(Product, id=product_id, producer=request.user.producer)
    
    if request.method == 'POST':
        discount = float(request.POST.get('discount', 0))
